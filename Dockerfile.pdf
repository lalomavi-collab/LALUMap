# PDF host (Hebrew RTL invoices and trust receipts). The base image ships Chromium and its system libraries,
# and its tag MUST match the playwright-core version in package.json (^1.64.0).
FROM mcr.microsoft.com/playwright:v1.64.0-noble
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY lib ./lib
COPY scripts/pdf-server.ts ./scripts/pdf-server.ts
COPY public/lalum-logo.svg ./public/lalum-logo.svg
USER pwuser
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Required at run time: SUPABASE_URL, SUPABASE_ANON_KEY. Never pass the service role key here.
CMD ["node", "scripts/pdf-server.ts"]
